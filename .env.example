# TPC NavBot Environment Configuration
# Replace with your actual Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional constrained LLM source selection; final answers remain source-grounded.
TPC_ENABLE_LLM_SELECTION=0
GEMINI_MODEL=gemini-3.5-flash-lite
# auto loads an already cached semantic model or uses a labelled lexical fallback.
# semantic fails if the model is unavailable; lexical never loads a model.
TPC_EMBEDDING_MODE=auto
# Optional project-relative overrides:
# TPC_RAW_DATA_DIR=TPC Navbot/data/raw
# TPC_SOURCE_REGISTRY=TPC Navbot/data/source_registry.json
# TPC_VECTOR_STORE_DIR=TPC Navbot/data/vector_store

